<Project>

  <!-- Single source of truth for product identity/version; applies to every project.
       Bump <Version> for releases (semver: major.minor.patch). -->
  <PropertyGroup>
    <Product>Countdown</Product>
    <AssemblyTitle>Countdown</AssemblyTitle>
    <Version>0.0.1</Version>
    <AssemblyVersion>0.0.1</AssemblyVersion>
    <FileVersion>0.0.1</FileVersion>
    <!-- Keep InformationalVersion clean: newer SDKs otherwise append "+<git sha>". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
